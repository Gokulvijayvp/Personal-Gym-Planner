# Server settings for Gym Planner. setup-server.sh copies this to /etc/gym-planner.env (owner root, readable only by the service)
# and fills in SECRET_KEY for you. Edit the lines marked CHANGE.

# --- how the app runs ---------------------------------------------------------------------------------------
# TEST MODE (plain http on the server's IP address):   APP_ENV=development  COOKIE_SECURE=false
#   Sign-up codes that Resend cannot email are written to the service log:  sudo journalctl -u gym-planner -f
# SECURE MODE (https, see DEPLOY.md step 8):           APP_ENV=production   COOKIE_SECURE=true
APP_ENV=development
APP_DEBUG=false
COOKIE_SECURE=false

# --- where things live -----------------------------------------------------------------------------------------
# DATABASE: use ONE of these two lines.
#  (A) a SQLite file on this server (simplest; nothing else to create):
DATABASE_URL=sqlite:////var/lib/gym-planner/gym_planner.db
#  (B) AWS RDS PostgreSQL (see DEPLOY.md part B). Replace this line with the endpoint you copied from the RDS page:
#      postgresql+psycopg://gymplanner:YOUR_PASSWORD@YOUR-RDS-ENDPOINT:5432/gymplanner?sslmode=require
#      If the password has special characters (@ : / ? # %), write them as %40 %3A %2F %3F %23 %25.
# Pictures and videos are always files on this server:
MEDIA_DIR=/var/lib/gym-planner/media
TIMEZONE=Asia/Kolkata

# --- the address people open in the browser (exactly, no slash at the end) --------------------------------------
# CHANGE: http://YOUR-EC2-PUBLIC-IP   (or https://YOUR-NAME.sslip.io once https is set up)
CORS_ORIGINS=http://YOUR-EC2-PUBLIC-IP

# --- secrets -------------------------------------------------------------------------------------------------------
# Filled in automatically by setup-server.sh. Keep it private. Changing it later signs everyone out.
SECRET_KEY=

# --- email (Resend). Same values as your local backend/.env --------------------------------------------------------
# CHANGE: paste your key and sender
EMAIL_BACKEND=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gym Planner <onboarding@resend.dev>
