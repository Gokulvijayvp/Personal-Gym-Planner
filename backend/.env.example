APP_NAME=Personal Gym Planner API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/gym_planner.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata

# Authentication (the first account that signs up becomes the admin; everyone after is a normal user)
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
SESSION_DAYS=30
COOKIE_SECURE=false
EMAIL_BACKEND=resend   # 'console' only logs the code (development)
# Production: APP_ENV=production, APP_DEBUG=false, COOKIE_SECURE=true, CORS_ORIGINS=https://your-domain

# Email delivery (Resend). Keep the real key only in your private .env, never in the frontend or git.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=Gym Planner <onboarding@resend.dev>
